{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/XiangXiaoYuan5254/folio-plugins/main/schema/folio-plugin.schema.json",
  "title": "页间（Folio）插件清单 folio-plugin.json",
  "description": "页间插件的清单。完整说明见 https://github.com/XiangXiaoYuan5254/folio-plugins/blob/main/docs/manifest.md 。这个 Schema 帮编辑器补全和提示；最终以 `folio-plugin validate` 和页间的检查为准（比如“用到联网工具就要写 permissions.network”这类跨字段规则只有它们会查）。",
  "type": "object",
  "required": ["folio", "id", "name", "version", "files", "run"],
  "properties": {
    "$schema": { "type": "string" },
    "folio": {
      "const": 1,
      "description": "插件格式版本，现在是 1。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$",
      "description": "插件的唯一标识：小写字母、数字和 -，2–40 个字符。发布后不要再改；插件目录里也用它。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "显示给用户的名字，最多 40 个字。"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "版本号，如 1.2.0，可以带预发布后缀，如 1.3.0-beta.1。"
    },
    "author": { "type": "string", "maxLength": 60, "description": "作者。" },
    "description": {
      "type": "string",
      "maxLength": 300,
      "description": "一两句话说明它做什么、结果放在哪里。安装时用户会看到。"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "description": "主页或说明文档，只能是 https 链接。"
    },
    "engines": {
      "type": "object",
      "properties": {
        "folio": {
          "type": "string",
          "description": "需要的页间版本，如 \">=0.30.0\"、\">=0.30.0 <1.0.0\"、\"0.30.0\" 或 \"*\"。"
        }
      },
      "additionalProperties": false
    },
    "icon": {
      "type": "string",
      "pattern": "\\.(svg|png)$",
      "description": "图标文件（.svg 或 .png），必须列在 files 里。建议 64×64 的 SVG。"
    },
    "files": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "description": "除 folio-plugin.json 以外插件里的所有文件。只能是 .md .html .htm .css .txt .json .svg .png，加上 run.script 指向的一个 .js；每个不超过 1 MB，合计不超过 2 MB。",
      "items": {
        "type": "string",
        "pattern": "^[\\w.\\-/]+\\.(md|html|htm|css|txt|json|svg|png|js)$"
      }
    },
    "run": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "pattern": "\\.md$",
          "description": "交给 AI 的任务说明（Markdown），必须列在 files 里。可以用 {{设置项}} 和内置变量。"
        },
        "template": {
          "type": "string",
          "description": "可选，输出模板（通常是 HTML）。AI 会照它的结构和样式写结果。"
        },
        "script": {
          "type": "string",
          "pattern": "\\.js$",
          "description": "可选，插件脚本：在沙箱里运行，用 folio.registerTool 给 AI 增加工具。"
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "description": "AI 运行时能用的页间工具。在自己文件夹里工作的插件（where: \"folder\"）只能用 list_files、read_document、create_html、fetch_url、read_feed、search_papers。",
          "items": {
            "enum": [
              "list_files",
              "search",
              "read_document",
              "read_annotations",
              "read_html_source",
              "open_document",
              "search_papers",
              "fetch_url",
              "read_feed",
              "create_html",
              "edit_html",
              "add_highlights",
              "write_note",
              "save_pdf"
            ]
          }
        },
        "web": {
          "type": "boolean",
          "description": "为 true 时，模型还能用服务自带的联网搜索（服务支持时）。"
        },
        "where": {
          "enum": ["project", "folder"],
          "description": "project（默认）：在用户打开的项目里工作；folder：在插件自己的文件夹里工作，看不到用户的项目，permissions.write 要写成一个文件夹设置，如 [\"{{output}}\"]。"
        }
      }
    },
    "triggers": {
      "type": "array",
      "maxItems": 6,
      "description": "什么时候运行。没有写 button 时页间会自动加一个“运行<名字>”按钮。",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "time"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "daily" },
              "time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "description": "每天几点运行，如 08:30。用户可以在插件卡片上改或关掉。"
              }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "button" },
              "label": {
                "type": "string",
                "maxLength": 24,
                "description": "按钮上的字，如“生成今天的日报”。"
              }
            }
          }
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "description": "能访问的网站（只支持 https）。*.example.com 表示 example.com 和它所有的子域名。用 fetch_url、read_feed 或脚本时必须写。",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?([a-z0-9-]+\\.)+[a-z0-9-]{2,}$"
          }
        },
        "write": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "description": "能新建或修改文件的文件夹（相对项目），可以引用设置，如 \"{{output}}\"。用写入工具时必须写。",
          "items": { "type": "string" }
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 12,
      "description": "用户可以在插件卡片上改的设置。值是字符串，在任务说明、模板和写入文件夹里用 {{key}} 引用，脚本里是 folio.settings.key。",
      "items": {
        "type": "object",
        "required": ["key"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,29}$",
            "not": {
              "enum": [
                "today",
                "yesterday",
                "week_ago",
                "now",
                "weekday",
                "project",
                "folder",
                "template"
              ]
            },
            "description": "设置项名称；不能和内置变量重名。"
          },
          "type": {
            "enum": ["text", "textarea", "folder"],
            "description": "text：一行字；textarea：多行；folder：文件夹（可以点“选择…”挑）。"
          },
          "label": { "type": "string", "maxLength": 40 },
          "hint": { "type": "string", "maxLength": 160 },
          "default": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}
